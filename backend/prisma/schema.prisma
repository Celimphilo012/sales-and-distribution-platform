// Phase 1A: Authentication + Users + Roles + Permissions
// Phase 1E: Orders, order items, order status history, reservations, customers
//
// STEP 4 OF THE SYSTEM SPLIT (ARCHITECTURE.md §A2): this app is now the
// Back-Office / Ordering System only. The catalogue (products/categories/
// images), warehouse structure (warehouses/locations) and the inventory
// ledger (balances/transactions/receiving/transfers/adjustments/counts)
// have moved to the standalone /warehouse app on its own database
// (warehouse_db) and are DELETED from here — do not re-add them. Order
// lines reference a product living in warehouse_db by plain id (no FK
// across the database boundary, per §A2).
//
// See ARCHITECTURE.md §E for the full target schema. Only tables this
// system owns are created here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  ordersAsConsultant        Order[]
  orderStatusChanges        OrderStatusHistory[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  module      String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Rotating refresh tokens. The raw token is only ever returned to the
// client once; only its hash is persisted. Rotation revokes the old row
// and issues a new one on every /auth/refresh call.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedByTokenId String? @map("replaced_by_token_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------
// Phase 1E: Orders, order items, order status history, customers.
// -----------------------------------------------------------------------

// Reference data — soft-deleted via status (rule 10): orders reference a
// customer historically.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  phone        String?
  address      String?
  locationText String?        @map("location_text")
  status       CustomerStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  orders Order[]

  @@map("customers")
}

// The full order lifecycle (§I), unchanged by the split — see
// src/orders/order-status-transitions.ts for the hop-by-hop map. Only the
// STOCK SIDE EFFECTS behind STOCK_RESERVED/DISPATCHED are stubbed pending
// step 5 (warehouse API wiring); the states themselves are unchanged.
enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  STOCK_RESERVED
  REJECTED
  CANCELLED
  PICKING
  PACKED
  READY_FOR_DISPATCH
  DISPATCHED
  PARTIALLY_FULFILLED
  DELIVERED
  COMPLETED
}

// Rule 6: separate from `status`, never touched by any status transition.
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique @map("order_number")
  customerId    String        @map("customer_id")
  consultantId  String?       @map("consultant_id")
  // No FK: sales_batches doesn't exist yet (Open Decision #4, not built).
  salesBatchId  String?       @map("sales_batch_id")
  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  orderDate     DateTime      @default(now()) @map("order_date")
  deliveryInfo  String?       @map("delivery_info")
  total         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consultant    User?               @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([consultantId])
  @@index([status])
  @@map("orders")
}

// Partial fulfilment (Open Decision #5, resolved): quantity_ordered vs
// quantity_fulfilled per line.
//
// productId is a PLAIN VALUE, not a foreign key (§A2 cross-boundary rule:
// "no foreign keys across the boundary") — the product it names lives in
// warehouse_db, a separate database this schema cannot reference. unitPrice/
// lineTotal are this line's price snapshot (unchanged by the split — this is
// what lets an order display without a live warehouse lookup). There is,
// however, no NAME snapshot on the line today (this predates the split, not
// introduced by it) — step 5 should add one, populated from the warehouse
// catalogue API at order-creation time, so a line still displays a product
// name if the catalogue entry is later renamed or deactivated.
model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  productId         String  @map("product_id")
  quantityOrdered   Decimal @map("quantity_ordered") @db.Decimal(14, 3)
  quantityFulfilled Decimal @default(0) @map("quantity_fulfilled") @db.Decimal(14, 3)
  // Phase 1F: intermediate fulfilment-workflow amounts. Neither is a stock
  // effect by itself — quantityFulfilled, set at dispatch, is what will
  // actually move stock once step 5 wires the warehouse API.
  quantityPicked    Decimal @default(0) @map("quantity_picked") @db.Decimal(14, 3)
  quantityPacked    Decimal @default(0) @map("quantity_packed") @db.Decimal(14, 3)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// One row per transition (append-only). fromStatus is null for the initial
// "created as DRAFT" row.
model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String       @map("changed_by")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User  @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_status_history")
}
