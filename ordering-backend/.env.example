DATABASE_URL="mysql://root:@localhost:3306/distribution_platform"

PORT=3300

# Only when the API is served under a sub-path (e.g. cPanel app URL https://host/api). Leave empty locally.
API_BASE_PATH=

CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3001"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# This app is a CLIENT of the warehouse system's API-key-protected external API (ARCHITECTURE.md §A2)
# — never a peer with database access. The key is issued in the warehouse app: Settings → API keys,
# with the scopes catalogue:read, stock:read, stock:reserve, stock:issue and locations:read.
WAREHOUSE_API_URL="http://localhost:3200"
WAREHOUSE_API_KEY="change-me-warehouse-api-key"
# WAREHOUSE_API_TIMEOUT_MS=20000

# Log level: fatal | error | warn | info | debug | silent
LOG_LEVEL=info

# Shown in email subjects, SMS texts and the authenticator app's account name.
APP_NAME="Ordering System"

# Web address of the ordering app; emails get an "open in the app" button linking here.
# Leave empty for no button. Local dev: http://localhost:8080
APP_URL=

# --- Secrets at rest ----------------------------------------------------------------
# Encrypts authenticator-app secrets and the SMTP password / httpSMS key saved from the admin
# Settings screen. Set ONCE (e.g. `openssl rand -hex 32`) and never change it — changing it makes
# every enrolled authenticator app and saved delivery credential unreadable. Empty = derived from
# JWT_REFRESH_SECRET (fine locally, set it in production).
SECRETS_ENCRYPTION_KEY=

# --- Email / SMS fallback -------------------------------------------------------------
# Normally set by an administrator IN THE APP (Settings -> Email & SMS delivery). These are only
# the fallback; until real sending is configured, emails and SMS are printed to the server log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# HTTPSMS_API_KEY=
# HTTPSMS_FROM=+268...
