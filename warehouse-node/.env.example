DATABASE_URL="mysql://root:@localhost:3306/warehouse_db"

PORT=3200

# Only when the API is served under a sub-path (e.g. cPanel app URL
# https://host/api). Leave empty locally.
API_BASE_PATH=

CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3001,http://localhost:8090"

JWT_ACCESS_SECRET="warehouse-change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="warehouse-change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

SEED_ADMIN_EMAIL="warehouse-admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Cache (in-memory LRU; see README "Caching") ---------------------------------
# CACHE_ENABLED=false turns every cache into a plain database read (useful when debugging).
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_MAX_ENTRIES=2000
# Bounds staleness for changes made by ANOTHER process; in-process writes invalidate immediately.
CACHE_PERMISSIONS_TTL_MS=30000
CACHE_API_KEY_TTL_MS=60000
CACHE_REFERENCE_TTL_MS=60000
CACHE_CATALOGUE_TTL_MS=60000
CACHE_REPORTS_TTL_MS=30000

# Pino log level: fatal | error | warn | info | debug | silent
LOG_LEVEL=info
