DATABASE_URL="mysql://root:@localhost:3306/warehouse_db"

PORT=3200

# Only when the API is served under a sub-path (e.g. cPanel app URL
# https://host/api). Leave empty locally.
API_BASE_PATH=

CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3001,http://localhost:8090"

JWT_ACCESS_SECRET="warehouse-change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="warehouse-change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

SEED_ADMIN_EMAIL="warehouse-admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Cache (in-memory LRU; see README "Caching") ---------------------------------
# CACHE_ENABLED=false turns every cache into a plain database read (useful when debugging).
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_MAX_ENTRIES=2000
# Bounds staleness for changes made by ANOTHER process; in-process writes invalidate immediately.
CACHE_PERMISSIONS_TTL_MS=30000
CACHE_API_KEY_TTL_MS=60000
CACHE_REFERENCE_TTL_MS=60000
CACHE_CATALOGUE_TTL_MS=60000
CACHE_REPORTS_TTL_MS=30000

# Log level: fatal | error | warn | info | debug | silent
LOG_LEVEL=info

# Shown in email subjects, SMS texts and the authenticator app's account name.
APP_NAME="Warehouse System"

# --- Secrets at rest ----------------------------------------------------------------
# Encrypts authenticator-app secrets and the SMTP password / httpSMS key saved from the admin
# Settings screen. Set ONCE (e.g. `openssl rand -hex 32`) and never change it — changing it makes
# every enrolled authenticator app and saved delivery credential unreadable. Unset = derived from
# JWT_REFRESH_SECRET (fine for local dev only).
SECRETS_ENCRYPTION_KEY=

# --- MFA / one-time codes ---------------------------------------------------------
# Email/SMS code lifetime (default 10 minutes), and codes a user may request per 10 minutes.
# OTP_CODE_TTL_MS=600000
# OTP_MAX_PER_WINDOW=5

# --- Email (SMTP) and SMS (httpSMS) -------------------------------------------------
# Normally set by an administrator in the app: Settings → Email & SMS delivery. Anything saved
# there overrides the values below; these are only the fallback (e.g. for a first deployment).
# Leave SMTP_HOST empty to print emails to the server log instead of sending (local dev).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Warehouse System <warehouse@example.com>"

# --- SMS (httpsms.com — sends through your own Android phone) ----------------------
# Leave HTTPSMS_API_KEY empty to print SMS texts to the server log instead of sending.
HTTPSMS_API_KEY=
# The phone number registered in the httpSMS Android app, international format, e.g. +26876000000
HTTPSMS_FROM=
