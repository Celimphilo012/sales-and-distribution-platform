    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "prisma": "^5.22.0"
  }
