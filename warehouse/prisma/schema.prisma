// Warehouse System — Step 1: Authentication + Users + Roles + Permissions.
// Step 2a: Catalogue (categories/products/product-images) + warehouse
// structure (warehouses/locations tree), moved from /backend's schema as-is.
// This is a STANDALONE app with its own database (warehouse_db), independent
// of the back-office /backend. Inventory/receiving/transfers/adjustments/
// counts move here in step 2b — do not add them yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  inventoryTransactionsPerformed InventoryTransaction[]
  stockAdjustmentsRequested StockAdjustment[] @relation("StockAdjustmentRequestedBy")
  stockAdjustmentsReviewed  StockAdjustment[] @relation("StockAdjustmentReviewedBy")
  stockCountsStarted        StockCount[]
  apiKeysCreated            ApiKey[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  module      String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Rotating refresh tokens — same approach as /backend: the raw token is
// only ever returned to the client once, only its hash is persisted, and
// rotation revokes the old row and issues a new one on every /auth/refresh.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  tokenHash         String    @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  // Step 3: set instead of userId when an API key (not a logged-in user)
  // performed the mutating request — the two are mutually exclusive in
  // practice (a request is authenticated by exactly one of AuthGuard's JWT
  // or ApiKeyGuard's key), but both stay nullable so neither guard has to
  // know about the other.
  apiKeyId  String?  @map("api_key_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([apiKeyId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------
// Step 2a: Catalogue — moved from /backend as-is (same fields, same
// constraints). Relations to not-yet-moved models (inventory balances/
// transactions, stock adjustments/counts, order items) are intentionally
// omitted here — they come back when those tables move in step 2b.
// -----------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

// Reference data — soft-deleted via is_active (rule 10), never hard-deleted,
// since products reference a category historically.
//
// workstreamId: a catalogue-organization layer (Warehouse -> Workstream ->
// Category -> sub-category -> Product), added after categories already
// existed unscoped to any warehouse (see the Workstream model doc comment for
// the migration/backfill this required). Every category belongs to exactly
// ONE workstream — this is purely organizational, never read by inventory/
// ledger code.
model Category {
  id           String  @id @default(uuid())
  name         String
  parentId     String? @map("parent_id")
  workstreamId String  @map("workstream_id")
  isActive     Boolean @default(true) @map("is_active")

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  workstream Workstream @relation(fields: [workstreamId], references: [id], onDelete: Restrict)
  products   Product[]

  @@index([parentId])
  @@index([workstreamId])
  @@map("categories")
}

// -----------------------------------------------------------------------
// Workstreams — a catalogue-organization layer, NOT operational (does not
// affect inventory/stock/permissions/fulfilment). Sits between Warehouse and
// Category: Warehouse -> Workstream -> Category -> sub-category -> Product.
// A workstream belongs to exactly one warehouse, mirroring how Location does
// (warehouseId + unique(warehouseId, code)).
//
// Added after categories already existed with NO warehouse scoping at all
// (categories were, and remain structurally, global reference data — see the
// Category model). The migration that introduced this column backfilled
// every pre-existing category onto ONE default workstream (name "General",
// code "GEN") rather than one-per-warehouse, since there was no existing
// per-category warehouse signal to split them by. See migration
// `add_workstreams` for the exact backfill.
model Workstream {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  categories Category[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("workstreams")
}

// Reference data — soft-deleted via status (rule 10), never hard-deleted,
// since orders/inventory transactions reference products historically.
model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  name          String
  description   String?
  categoryId    String        @map("category_id")
  sellingPrice  Decimal       @map("selling_price") @db.Decimal(12, 2)
  costPrice     Decimal?      @map("cost_price") @db.Decimal(12, 2)
  uom           String
  minStockLevel Decimal       @default(0) @map("min_stock_level") @db.Decimal(12, 2)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  attributes ProductAttribute[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  stockAdjustments      StockAdjustment[]
  stockCountItems       StockCountItem[]
  stockReservationLines StockReservationLine[]

  @@index([categoryId])
  @@map("products")
}

// -----------------------------------------------------------------------
// Product attributes — catalogue METADATA only (colour, size, weight, brand,
// material, dimensions, extensible for more). NOT variants: stock stays
// keyed by (product_id, location_id) regardless of any attribute value
// (rule 3) — this table is never read by inventory/ledger code, and
// applyTransaction/inventory_balances are untouched.
//
// Defined-types model, not fixed columns: AttributeType is an admin-managed
// catalog (like Category/Workstream) so a brand-new attribute (e.g. "Country
// of Origin") is a ROW an admin adds, not a schema migration. Each product
// carries at most one value per type (@@unique below) — one colour, one
// weight, etc.
// -----------------------------------------------------------------------

enum AttributeDataType {
  TEXT
  NUMBER
}

// Reference data — soft-deleted via is_active (rule 10), never hard-deleted,
// since products reference an attribute type historically.
model AttributeType {
  id        String            @id @default(uuid())
  name      String
  code      String            @unique
  dataType  AttributeDataType @default(TEXT) @map("data_type")
  // Display unit for NUMBER types (e.g. "kg"); also usable as a hint for a
  // TEXT type whose values conventionally carry a unit (e.g. Dimensions ->
  // "cm", with the value itself free text like "30x20x5"). Never enforced
  // beyond that — it's descriptive, not a second data type.
  unit      String?
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  productAttributes ProductAttribute[]

  @@map("attribute_types")
}

// value is always stored as a string — the same "string" shape Decimal
// columns already serialize as on read (selling_price etc.), so a NUMBER-type
// value round-trips through JSON identically to a TEXT one; the frontend
// coerces it per the attribute type's dataType.
model ProductAttribute {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  attributeTypeId String   @map("attribute_type_id")
  value           String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeType AttributeType @relation(fields: [attributeTypeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeTypeId])
  @@index([attributeTypeId])
  @@map("product_attributes")
}

// Pure media rows, not historically referenced by orders/transactions —
// hard-deleted is fine here, unlike products/categories.
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// -----------------------------------------------------------------------
// Step 2a: Warehouse structure — moved from /backend as-is. Relations to
// not-yet-moved inventory/stock-count models are omitted here for the same
// reason as above.
// -----------------------------------------------------------------------

model Warehouse {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  locations   Location[]
  stockCounts StockCount[]
  workstreams Workstream[]

  @@map("warehouses")
}

// Self-referencing tree, unlimited depth (rule 5). location_type is a free
// label (e.g. ZONE/AISLE/RACK/SHELF/LEVEL/BIN/...) — never an enum, so admins
// can invent new labels without a migration. Soft-deleted via is_active.
model Location {
  id           String   @id @default(uuid())
  warehouseId  String   @map("warehouse_id")
  parentId     String?  @map("parent_id")
  name         String
  code         String
  locationType String   @map("location_type")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[] @relation("LocationTree")
  inventoryBalances     InventoryBalance[]
  transactionsFrom      InventoryTransaction[] @relation("InventoryTxFromLocation")
  transactionsTo        InventoryTransaction[] @relation("InventoryTxToLocation")
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  stockCountItems       StockCountItem[]
  stockReservationLines StockReservationLine[]

  @@unique([warehouseId, code])
  @@index([warehouseId, parentId])
  @@map("locations")
}

// -----------------------------------------------------------------------
// Step 2b: Inventory ledger — moved from /backend EXACTLY as-is (frozen
// logic, rule 2). inventory_balances is a cache, NEVER written directly:
// only InventoryService.applyTransaction() writes it, inside the same DB
// transaction as the inventory_transactions row that justifies the change.
// A DB trigger (hand-added in this migration's SQL) backstops this at the
// database level, independent of application discipline.
// -----------------------------------------------------------------------

enum InventoryTransactionType {
  RECEIVE
  TRANSFER
  ISSUE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  LOST
  STOCK_COUNT
  RESERVATION
  RELEASE_RESERVATION
}

// Buckets are distinct (rule 4): on_hand, reserved, damaged, lost, expired.
// available = on_hand - reserved (computed, not stored). All buckets are
// CHECK-constrained >= 0 at the DB level (hand-added in this migration).
model InventoryBalance {
  id         String  @id @default(uuid())
  productId  String  @map("product_id")
  locationId String  @map("location_id")
  onHand     Decimal @default(0) @map("on_hand") @db.Decimal(14, 3)
  reserved   Decimal @default(0) @map("reserved") @db.Decimal(14, 3)
  damaged    Decimal @default(0) @map("damaged") @db.Decimal(14, 3)
  lost       Decimal @default(0) @map("lost") @db.Decimal(14, 3)
  expired    Decimal @default(0) @map("expired") @db.Decimal(14, 3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@map("inventory_balances")
}

// Append-only ledger — the source of truth (rule 2). Never updated or
// deleted by the application. orderId is a plain column, no FK — orders
// live in distribution_platform on the other side of the system split.
model InventoryTransaction {
  id             String                   @id @default(uuid())
  type           InventoryTransactionType
  productId      String                   @map("product_id")
  fromLocationId String?                  @map("from_location_id")
  toLocationId   String?                  @map("to_location_id")
  quantity       Decimal                  @db.Decimal(14, 3)
  reason         String?
  reference      String?
  orderId        String?                  @map("order_id")
  performedBy    String                   @map("performed_by")
  createdAt      DateTime                 @default(now()) @map("created_at")

  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation    Location? @relation("InventoryTxFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation      Location? @relation("InventoryTxToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  performedByUser User      @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("inventory_transactions")
}

// -----------------------------------------------------------------------
// Step 2b: Receiving, transfers, stock adjustments (2-step approval), stock
// counts. Receiving and transfers have no dedicated table — they call
// InventoryService.applyTransaction() directly and the resulting
// inventory_transactions row IS their record. Adjustments and counts get
// their own tables because they have a lifecycle (PENDING/APPROVED/
// REJECTED, OPEN/SUBMITTED) that exists BEFORE any stock moves.
// -----------------------------------------------------------------------

enum AdjustmentBucket {
  ON_HAND
  RESERVED
  DAMAGED
  LOST
  EXPIRED
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Two-step approval (rule 7 / Open Decision #2, resolved): a request never
// touches inventory_balances by itself. Only approve() calls
// InventoryService.applyTransaction() — reject() and the PENDING state have
// zero ledger effect. Separation of duties is enforced in
// StockAdjustmentsService: reviewedBy must differ from requestedBy.
model StockAdjustment {
  id          String              @id @default(uuid())
  productId   String              @map("product_id")
  locationId  String              @map("location_id")
  bucket      AdjustmentBucket
  delta       Decimal             @db.Decimal(14, 3)
  direction   AdjustmentDirection
  reason      String
  reference   String?
  status      AdjustmentStatus    @default(PENDING)
  requestedBy String              @map("requested_by")
  requestedAt DateTime            @default(now()) @map("requested_at")
  reviewedBy  String?             @map("reviewed_by")
  reviewedAt  DateTime?           @map("reviewed_at")
  reviewNote  String?             @map("review_note")

  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  requestedByUser User     @relation("StockAdjustmentRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewedByUser  User?    @relation("StockAdjustmentReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([locationId])
  @@index([status])
  @@map("stock_adjustments")
}

enum StockCountStatus {
  OPEN
  SUBMITTED
}

// Scoped to one leaf location per count. Starting a count snapshots
// expected_qty (current on_hand) per product into stock_count_items;
// submitting fills in counted_qty and computes difference. The count
// itself never moves stock — each nonzero difference becomes its own
// PENDING StockAdjustment (reason: "stock count", reference: this count's
// id), which only takes effect once approved through the same flow as any
// other adjustment.
model StockCount {
  id          String           @id @default(uuid())
  warehouseId String           @map("warehouse_id")
  locationId  String           @map("location_id")
  status      StockCountStatus @default(OPEN)
  startedBy   String           @map("started_by")
  startedAt   DateTime         @default(now()) @map("started_at")
  submittedAt DateTime?        @map("submitted_at")

  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location      Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  startedByUser User             @relation(fields: [startedBy], references: [id], onDelete: Restrict)
  items         StockCountItem[]

  @@index([warehouseId])
  @@index([locationId])
  @@map("stock_counts")
}

model StockCountItem {
  id           String   @id @default(uuid())
  stockCountId String   @map("stock_count_id")
  productId    String   @map("product_id")
  locationId   String   @map("location_id")
  expectedQty  Decimal  @map("expected_qty") @db.Decimal(14, 3)
  countedQty   Decimal? @map("counted_qty") @db.Decimal(14, 3)
  difference   Decimal? @db.Decimal(14, 3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([stockCountId])
  @@map("stock_count_items")
}

// -----------------------------------------------------------------------
// Step 3: API-key external API — system-to-system access (no user login)
// for the back-office (and later other consumers) to read the catalogue and
// drive reserve/release/issue. This layer only ever CALLS
// InventoryService.applyTransaction() (rule 2) — it never writes
// inventory_balances/inventory_transactions itself, and the frozen ledger
// tables/trigger above are untouched.
// -----------------------------------------------------------------------

// Only a hash is ever stored (argon2, like passwords) — the raw key is
// returned to the caller exactly once, at creation. `scopes` is a small,
// fixed set (catalogue:read / stock:read / stock:reserve / stock:issue),
// stored as a JSON string array rather than a join table — "minimal
// mechanism, no management UI" doesn't warrant normalizing it further.
model ApiKey {
  id           String    @id @default(uuid())
  name         String
  keyHash      String    @map("key_hash")
  scopes       Json
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdBy    String    @map("created_by")

  createdByUser User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  reservations  StockReservation[]
  auditLogs     AuditLog[]

  @@map("api_keys")
}

enum StockReservationStatus {
  RESERVED
  RELEASED
  ISSUED
}

// Tracks a reservation by the CALLER's own `reference` (their order id) so
// reserve/release/issue can all be idempotent on it — a retried call with
// the same reference replays the original result instead of double-acting.
// This table itself never moves stock; every state change here is preceded
// by a real InventoryService.applyTransaction() call (RESERVATION /
// RELEASE_RESERVATION / ISSUE) that actually does.
model StockReservation {
  id        String                 @id @default(uuid())
  reference String                 @unique
  status    StockReservationStatus @default(RESERVED)
  apiKeyId  String?                @map("api_key_id")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  apiKey ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  lines  StockReservationLine[]

  @@map("stock_reservations")
}

model StockReservationLine {
  id             String  @id @default(uuid())
  reservationId  String  @map("reservation_id")
  productId      String  @map("product_id")
  locationId     String  @map("location_id")
  quantity       Decimal @db.Decimal(14, 3)
  issuedQuantity Decimal @default(0) @map("issued_quantity") @db.Decimal(14, 3)

  reservation StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId, locationId])
  @@index([reservationId])
  @@map("stock_reservation_lines")
}
